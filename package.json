{
  "name": "relaxicise",
  "private": true,
  "version": "0.1.0",
  "description": "Work with focus. Move with intention. Return refreshed. Camera-checked movement breaks in the browser.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "predev:lan": "node scripts/fetch-assets.mjs",
    "dev:lan": "vite --mode lan",
    "prebuild": "node scripts/fetch-assets.mjs --strict",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:video": "node scripts/demo/record.mjs",
    "demo:short": "node scripts/demo/short.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "@vercel/analytics": "^1.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "kokoro-js": "^1.2.1",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
